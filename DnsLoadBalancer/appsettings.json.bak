{
  "DnsLoadBalancer": {
    "DnsPort": 53,
    "DnsBindAddress": "0.0.0.0",
    "TlsCheckIntervalSeconds": 26,
    "TlsTimeoutMs": 10000,
    "UploadTestSizeKB": 500,
    "TlsPort": 443,
    "MaxConcurrentChecks": 10,
    "MaxHealthyIpsTarget": 10, //Tedad IP vase scan
    "MaxAnswerCount": 3,
    "ResponseTtlSeconds": 60,
    // TlsCheckDomain: SNI domain for TLS handshake check.
    // Set to "" to use each domain's own name (e.g. dl1.morgh-sokhari.ir)
    // Set to a specific domain (e.g. "deluxhost.net") to override for all pools
    "TlsCheckDomain": "deluxhost.net",
    // ValidateTlsCertificate: true = only IPs with valid cert for TlsCheckDomain pass
    "ValidateTlsCertificate": true,
    // RoutingMode can be:
    // "LowestPing" : Returns the fastest IPs with round-robin shuffle
    // "Sequential" : Returns the first healthy IPs exactly as ordered in your txt file
    "RoutingMode": "Sequential", 
    "Domains": [
      {
        "Name": "dl1.morgh-sokhari.ir",
        "IpListFilePath": ".//dbs/vip.txt"
      },
      {
        "Name": "dl4.morgh-sokhari.ir",
        "IpListFilePath": ".//dbs/vip2.txt"
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "Console": {
      "FormatterName": "systemd"
    }
  }
}
